# Copy to .env.local and fill in real values. .env.local is git-ignored —
# never commit real credentials. Every variable below is SERVER-ONLY.

# ---- Database (Supabase PostgreSQL) ----------------------------------------
# Supabase → Project → Connect → "Transaction pooler" connection string.
# The role must own the tables (it runs the migrations) — `postgres` on Supabase.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_POOL_MAX=5

# Public site origin used for payment callback URLs (no trailing slash).
APP_URL=https://chisseled.com

# ---- Supabase Storage (optional: admin image uploads) -----------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images

# ---- Payments ----------------------------------------------------------------
# Paystack → Settings → API Keys & Webhooks. Webhook URL: https://<site>/api/webhooks/paystack
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Flutterwave → Settings → API keys / Webhooks. Webhook URL: https://<site>/api/webhooks/flutterwave
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
# The "secret hash" you set on the Flutterwave webhook settings page.
FLUTTERWAVE_WEBHOOK_HASH=

# ---- Scheduled maintenance -------------------------------------------------------
# Call GET /api/cron/maintenance with "Authorization: Bearer $CRON_SECRET" every ~10 min.
CRON_SECRET=

# ---- Email (optional: order confirmations via Resend) --------------------------
RESEND_API_KEY=
EMAIL_FROM="CHISSELED <orders@chisseled.com>"

# ---- Images ---------------------------------------------------------------------
# Extra HTTPS image hosts (comma-separated), e.g. while migrated photos are rehosted.
IMAGE_REMOTE_HOSTS=

# ---- AI shopping assistant ---------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
